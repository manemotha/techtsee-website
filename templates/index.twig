{% extends "base.twig" %}

{% block content %}

<!-- INTRODUCTION -->
<div class="introduction-container">

    <div class="intro-content-layout">
        <!-- PARAGRAPHS -->
        <div style="display: grid; gap: 20px">
            <h5 style="margin: 0">
                Transform your technology and future-proof your business with our
                <span style="color: var(--primary-color); font-family: Roboto-Bold, sans-serif">Innovative ICT</span>
                solutions
            </h5>
            <p style="margin: 0">
                Our mission is to provide clients with exceptional service. In-depth resources & tutorials, a vibrant community, round-the-clock support ensure a seamless experience.
            </p>
            <div style="display: flex; gap: 10px">
                <span class="tag">Computer repair</span>
                <span class="tag">Camera installation</span>
                <span class="tag">Website development</span>
            </div>
        </div>

        <!-- IMAGE -->
        <img class="intro-image" alt="introduction" src="./static/images/introduction.png">
    </div>

    <!-- INTRO_BUTTON -->
    <a href="#store" class="intro-button">Explore Store</a>

    <!-- SECTION_BREAK -->
    <span style="width: 100%; height: 0; border-bottom: 1px solid var(--border-color); margin-top: 100px"></span>
</div>

<!-- SERVICES -->
<div class="services-container">
    <h5 class="services-section-title">
        We offer Microsoft Windows, Microsoft Office Products, licensed Antivirus and Design tools.
    </h5>

    <!-- SERVICES_TABLE -->
    <div class="services-tables-container">
        {% for service in services %}
            <table class="services-table" aria-label="Details">
                <tbody>
                <!-- TITLE -->
                <th class="table-title">{{service["title"]}}</th>
                {% for item in service['services'] %}
                    <tr class="table-row">
                        <td class="table-item">{{item['title']}}
                            <span class="item-price">R{{item['price']}}</span>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endfor %}
    </div>
</div>

<!-- SHOP -->
<section id="store" class="section">
    <div class="shop-container" style="padding-top: 0;">

        <!-- SECTION_BREAK -->
        <nav style="width: 100%; height: 0; border-bottom: 1px solid var(--border-color)"></nav>

        <!-- MARGIN_LAYOUT -->
        <div style="padding-top: var(--section-padding); padding-bottom: var(--section-padding)">

            <!-- SECTION_TITLE -->
            <div style="display: grid; grid-template-columns: 100fr max-content; align-items: center">
                <nav>
                    <h5 class="shop-section-title">
                        <span style="font-size: var(--title-font-size); font-weight: normal; font-family: Roboto-Bold, sans-serif">
                            <img style="width: 20px; margin: 0 2px -1.5px 0" src="./static/images/icons/buy.png">Online Store
                        </span>
                        <br>
                        <br>
                        Scroll through our most intuitive problem-solving and smart products.
                    </h5>
                </nav>
                <a href="{{URL_BASENAME}}/store" class="link-text">View more products</a>
            </div>

            <!-- PRODUCTS_CONTAINER -->
            <div class="products-container">

                {% for product in products %}
                    <a href="#" class="product-item-container">

                        <div style="display: grid; grid-template-columns: 100fr max-content; align-items: start; height: min-content">

                            <!-- NAME, DESCRIPTION, TAGS -->
                            <nav>
                                <h5 class="product-name">{{product['name']}}</h5>
                                <p class="product-description">{{product['description']}}</p>
                                <!-- TAGS -->
                                <nav class="product-tags-container">
                                    {% for tag in product['tags'] %}
                                        <span class="product-tag">{{tag}}</span>
                                    {% endfor %}
                                </nav>
                            </nav>
                            <!-- IMAGE -->
                            <nav class="product-image-container">
                                <img class="product-image" src="{{product['image_url']}}" alt="{{product['image_alt']}}">
                            </nav>

                        </div>

                    </a>
                {% endfor %}

            </div>
        </div>
    </div>
</section>

{% endblock %}
