{% extends "base.twig" %}

{% block content %}

<style>
    .introduction-container {
        min-height: 600px;
        display: grid;
        grid-template-rows: auto max-content;
        justify-items: center;
        margin-right: var(--desktopMargin);
        margin-left: var(--desktopMargin);
    }
    .intro-content-layout {
        display: grid;
        grid-template-columns: auto min-content;
        align-items: center;
        min-height: 550px;
        width: 100%;
        gap: 100px;
    }

    /* TITLE */
    .intro-content-layout h5 {
        font-family: Roboto-Regular, sans-serif;
        font-size: 30px;
        font-weight: normal;
        max-width: 590px;
        color: var(--titleTextColor);
    }
    /* PARAGRAPH */
    .intro-content-layout p {
        max-width: 550px;
        font-family: Roboto-Light, sans-serif;
        font-size: var(--contentFontSize);
        color: var(--secondaryTextColor);
    }
    .tag {
        font-family: Roboto-Light, sans-serif;
        font-weight: normal;
        font-size: 12px;
        padding: 5px 10px 5px 10px;
        border-radius: 3px;
        background-color: #E4E4E4;
        color: var(--titleTextColor);
    }
    /* IMAGE */
    .intro-image {
        width: 400px;
    }
    /* BUTTON */
    .intro-button {
        height: 50px;
        padding: 0 30px 0 30px;
        border-radius: var(--borderRadius);
        background-color: var(--primaryColor);
        color: white;
        border: none;
        transition: 0.2s ease;
    }
    .intro-button:hover {
        padding: 0 40px 0 40px;
        cursor: pointer;
        transition: 0.2s ease;
    }
    .intro-button:active {
        opacity: 0.8;
        transition: 0.2s ease;
    }


    /* SERVICES */
    .services-container {
        font-size: var(--contentFontSize);
        padding-top: var(--sectionPadding);
        padding-bottom: var(--sectionPadding);
        margin-right: var(--desktopMargin);
        margin-left: var(--desktopMargin);
    }
    .services-section-title {
        font-family: Roboto-Light, sans-serif;
        font-size: var(--contentFontSize);
        font-weight: normal;
        justify-self: center;
        text-align: center;
        color: var(--titleTextColor);
        max-width: 270px;
        margin-bottom: 60px;
    }
    /* SERVICES_TABLE */
    .services-tables-container {
        display: grid;
        grid-template-columns: auto auto;
        column-gap: 100px;
        row-gap: 50px;
        align-items: start;
        margin-bottom: var(--sectionPadding);
    }
    .services-table {
        width: 100%;
    }
    .table-title {
        text-align: left;
        font-size: var(--contentFontSize);
        color: var(--titleTextColor);
        border-bottom: 1px solid var(--borderColor);
        font-weight: normal;
        height: 30px;
    }
    .table-row {
        height: 25px;
    }
    .table-item {
        display: grid;
        width: 100%;
        align-self: center;
        font-family: Roboto-Light, sans-serif;
        font-size: var(--contentFontSize);
        color: var(--secondaryTextColor);
        border-bottom: 1px solid var(--borderColor);
        font-weight: normal;
    }
    .item-price {
        font-family: Roboto-Regular, sans-serif;
        color: var(--primaryColor);
        position: absolute;
        justify-self: flex-end;
    }


    /* SHOP */
    .shop-container {
        background-color: var(--secondaryBackgroundColor);
        padding-bottom: var(--sectionPadding);
    }
    .shop-section-title {
        font-family: Roboto-Light, sans-serif;
        font-weight: normal;
        max-width: 300px;
        margin-bottom: var(--sectionPadding);
    }
    /* PRODUCT */
    .products-container {
        display: grid;
        grid-template-columns: 100fr 100fr;
        gap: 60px;
    }
    .product-item-container {
        display: grid;
        padding: 40px;
        gap: 20px;
        text-decoration: none;
        border-radius: var(--borderRadius);
        background-color: white;
        border: 2px solid transparent;
        transition: 0.2s ease;
    }
    .product-item-container:hover {
        border: 2px solid var(--hoverBorderColor);
        cursor: pointer;
        transition: 0.2s ease;
    }
    .product-name {
        font-size: var(--titleFontSize);
        font-weight: normal;
        font-family: Roboto-Bold, sans-serif;
        color: var(--primaryColor);
        margin: 0;
    }
    .product-description {
        font-family: Roboto-Light, sans-serif;
        font-weight: normal;
        font-size: var(--contentFontSize);
        color: var(--secondaryTextColor);
        overflow: hidden;
        white-space: pre-wrap;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        max-height: 80px;
        margin: 10px 0 0 0;
    }
    .product-image-container {
        width: 200px;
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: right;
        overflow: hidden;
        border-radius: var(--borderRadius);
    }
    .product-image {
        display: block;
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: cover;
    }
    .product-tags-container {
        display: grid;
        grid-template-columns: auto auto auto;
        width: max-content;
        gap: 5px;
        margin-top: 10px;
    }
    .product-tag {
        font-size: 11px;
        border-radius: 3px;
        padding: 3px 7px 3px 7px;
        width: max-content;
        color: var(--secondaryTextColor);
        background-color: var(--secondaryBackgroundColor);
    }

    /* TABLET_MEDIA_QUERIES */
    @media screen and (max-width: 1100px) {
        .products-container {
            grid-template-columns: 100fr;
            row-gap: 30px;
        }
    }
</style>

<!-- INTRODUCTION -->
<div class="introduction-container">

    <div class="intro-content-layout">
        <!-- PARAGRAPHS -->
        <div style="display: grid; gap: 20px">
            <h5 style="margin: 0">
                Transform your technology and future-proof your business with our
                <span style="color: var(--primaryColor); font-family: Roboto-Bold, sans-serif">Innovative ICT</span>
                solutions
            </h5>
            <p style="margin: 0">
                Our mission is to provide clients with exceptional service. In-depth resources & tutorials, a vibrant community, round-the-clock support ensure a seamless experience.
            </p>
            <div style="display: flex; gap: 10px">
                <span class="tag">Computer repair</span>
                <span class="tag">Camera installation</span>
                <span class="tag">Website development</span>
            </div>
        </div>

        <!-- IMAGE -->
        <img class="intro-image" alt="introduction" src="./static/images/introduction.png">
    </div>

    <!-- INTRO_BUTTON -->
    <button class="intro-button">Explore Shop</button>

    <!-- SECTION_BREAK -->
    <span style="width: 100%; height: 0; border-bottom: 1px solid var(--borderColor); margin-top: 100px"></span>
</div>

<!-- SERVICES -->
<div class="services-container">
    <h5 class="services-section-title">
        We offer Microsoft Windows, Microsoft Office Products, licensed Antivirus and Design tools.
    </h5>

    <!-- SERVICES_TABLE -->
    <div class="services-tables-container">
        {% for service in services %}
            <table class="services-table" aria-label="Details">
                <tbody>
                <!-- TITLE -->
                <th class="table-title">{{service["title"]}}</th>
                {% for item in service['services'] %}
                    <tr class="table-row">
                        <td class="table-item">{{item['title']}}
                            <span class="item-price">R{{item['price']}}</span>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endfor %}
    </div>
</div>

<!-- SHOP -->
<div class="shop-container">

    <!-- MARGIN_LAYOUT -->
    <div style="margin-right: var(--desktopMargin); margin-left: var(--desktopMargin); padding-top: var(--sectionPadding); padding-bottom: var(--sectionPadding)">

        <!-- SECTION_TITLE -->
        <div style="display: grid; grid-template-columns: 100fr max-content; align-items: center">
            <nav>
                <h5 class="shop-section-title">
                    <span style="font-size: var(--titleFontSize); font-weight: normal; font-family: Roboto-Bold, sans-serif">
                        <img style="width: 20px; margin: 0 2px -1.5px 0" src="./static/images/icons/buy.png">Online Shop
                    </span>
                    <br>
                    <br>
                    Scroll through our most intuitive problem-solving and smart products.
                </h5>
            </nav>
            <a href="#" class="link-text">View more products</a>
        </div>

        <!-- PRODUCTS_CONTAINER -->
        <div class="products-container">

            {% for product in products %}
                <a href="#" class="product-item-container">

                    <div style="display: grid; grid-template-columns: 100fr max-content; align-items: start; height: min-content">

                        <!-- NAME, DESCRIPTION, TAGS -->
                        <nav>
                            <h5 class="product-name">{{product['name']}}</h5>
                            <p class="product-description">{{product['description']}}</p>
                            <!-- TAGS -->
                            <nav class="product-tags-container">
                                {% for tag in product['tags'] %}
                                    <span class="product-tag">{{tag}}</span>
                                {% endfor %}
                            </nav>
                        </nav>
                        <!-- IMAGE -->
                        <nav class="product-image-container">
                            <img class="product-image" src="{{product['image_url']}}" alt="{{product['image_alt']}}">
                        </nav>

                    </div>

                </a>
            {% endfor %}

        </div>
    </div>
</div>

{% endblock %}
