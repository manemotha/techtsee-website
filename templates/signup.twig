<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="./static/favicon.ico">
    <link rel="stylesheet" href="./static/css/main.min.css">
    <title>Signup</title>
</head>
<body>

<style>
    html, body {
        height: 100%;
    }
</style>

<main class="signup-container">
    <div style="width: 300px">

        <!-- FORM TITLE -->
        <h5 class="signup-form-title">TECHTSEE | SIGN UP</h5>

        <form class="signup-form-container" method="POST" action="{{URL_BASENAME}}/user/signup">
            <input class="signup-form-inputfield" type="text" aria-multiline="false" name="username" placeholder="Username">

            <input class="signup-form-inputfield" type="text" aria-multiline="false" name="names" placeholder="Names">

            <input class="signup-form-inputfield" type="email" aria-multiline="false" name="email" placeholder="Email">

            <input class="signup-form-inputfield" type="password" aria-multiline="false" name="password" placeholder="Password">

            <!-- TODO: Fix error, redirects even with empty fields -->
            <button class="signup-form-button" type="submit">Signup</button>

            <!-- LINK_TEXT -->
            <a href="{{URL_BASENAME}}/login" class="link-text" style="font-size: var(--content-font-size); margin-top: 5px">Already have an account?</a>
        </form>

    </div>
</main>

</body>
</html>
