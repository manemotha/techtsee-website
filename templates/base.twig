<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="./static/favicon.ico">
    <link rel="stylesheet" href="./static/css/index.css">
    <title>Techtsee - {{title}}</title>
</head>
<body>

<header id="header" class="navbar-container">

    <div class="navbar-layout">
        <!-- TRADEMARK -->
        <div>
            <h5 class="trademark">TECHTSEE</h5>
        </div>

        <!-- LINK BUTTONS -->
        <div class="navbar-buttons-layout">
            <a href="{{URL_BASENAME}}/" id="home-button" class="navbar-button">Home</a>
            <a href="{{URL_BASENAME}}/store" id="shop-button" class="navbar-button">Store</a>

            <!-- HANDLE: Account button functionalities for when a user is authenticated or not -->
            {% if USER_DATA %}
                <a href="#" class="login-button">
                    {{USER_DATA['displayName']}}<img src="./static/images/icons/account.png" alt="Profile icon">
                </a>
            {% else %}
                <a href="{{URL_BASENAME}}/login" class="login-button">
                    Login<img src="./static/images/icons/account.png" alt="Profile icon">
                </a>
            {% endif %}

        </div>
    </div>

</header>


<main id="main" class="content-area-container">

    {% block content %}
    <!-- page body content -->
    {% endblock %}

</main>


<footer id="footer">
    <!-- COPYRIGHT TAG -->
    <div>
        <h5 class="address">
            <b>© 2025 Techtsee</b>
            <br>
            Bhambanana, MFT Office Pack C02, Bhambanana, MFT Office Pack C02, MFT Office number C02, Bhambanana, 3969
        </h5>
    </div>
    <!-- LINKS -->
    <div style="display: flex; gap: 10px">
        <a href="#"><img alt="Whatsapp" class="social-link-icon" src="./static/images/icons/social/whatsapp.png"></a>
        <a href="#"><img alt="Facebook" class="social-link-icon" src="./static/images/icons/social/facebook.png"></a>
        <a href="#"><img alt="Tiktok" class="social-link-icon" src="./static/images/icons/social/tiktok.png"></a>
        <a href="#"><img alt="Instagram" class="social-link-icon" src="./static/images/icons/social/instagram.png"></a>
    </div>
</footer>

<script>
    document.addEventListener("DOMContentLoaded", ()=>{
        if (window.location.pathname === "{{URL_BASENAME}}/") {
            document.getElementById("home-button").classList.add("selected-navbar-button");
        } else if (window.location.pathname === "{{URL_BASENAME}}/store") {
            document.getElementById("shop-button").classList.add("selected-navbar-button");
        }
    });
</script>

</body>
</html>
