{% extends "base.twig" %}

{% block content %}

<div class="shop-container">

    <!-- SEARCH_AREA -->
    <div>
        <label class="searchfield-label">Search for a product</label>
        <form class="searchfield-container">
            <img alt="Search icon" class="searchfield-icon" src="./static/images/icons/search.png">
            <input name="searchfield" class="searchfield" type="text" aria-multiline="false" placeholder="Product name">
            <button type="submit" class="searchfield-search-button" >Search</button>
        </form>
    </div>

    <!-- PRODUCTS_CONTAINER -->
    <div class="products-container">

        {% for product in products %}
            <div class="product-item-container">

                <div style="display: grid; grid-template-columns: 100fr max-content; align-items: start; height: min-content">

                    <!-- NAME, DESCRIPTION, TAGS -->
                    <nav>
                        <h5 class="product-name">{{product['name']}}</h5>
                        <p class="product-description">{{product['description']}}</p>
                        <!-- TAGS -->
                        <nav class="product-tags-container">
                            {% for tag in product['tags'] %}
                                <span class="product-tag">{{tag}}</span>
                            {% endfor %}
                        </nav>
                    </nav>
                    <!-- IMAGE -->
                    <nav class="product-image-container">
                        <img class="product-image" src="{{product['image_url']}}" alt="{{product['image_alt']}}">
                    </nav>

                </div>

                <div style="display: grid; grid-template-columns: max-content max-content; align-items: center; gap: 15px">
                    <!-- BUY_BUTTON -->
                    <a class="product-buy-button">
                        Add to Cart
                    </a>
                    <!-- PRICE -->
                    <h5 class="product-price">R{{product['price']}}</h5>
                </div>

            </div>
        {% endfor %}

    </div>
</div>

{% endblock %}
